{
  "name": "@traceryn/tiktok-sdk",
  "type": "module",
  "version": "1.0.0",
  "description": "Structured TikTok data for modern applications.",
  "license": "MIT",
  "author": "Corex Anthony",
  "homepage": "https://github.com/traceryn/tiktok-sdk#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/traceryn/tiktok-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/traceryn/tiktok-sdk/issues"
  },
  "keywords": [
    "tiktok",
    "api",
    "unofficial",
    "typescript"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    }
  },
  "files": [
    "lib/**/*",
    "engineRequirements.js"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -P tsconfig.build.json && tsc-esm-fix --tsconfig=tsconfig.build.json --ext=.js && node -e \"require('fs').cpSync('src/utils/xbogus.cjs', 'lib/utils/xbogus.cjs')\"",
    "build:docs": "typedoc",
    "build:all": "npm run build && npm run build:docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "tsc --noEmit && eslint src",
    "lint:fix": "npm run format && npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "preinstall": "node ./engineRequirements.js",
    "docs": "typedoc",
    "clean": "rimraf lib",
    "example": "node docs/examples/index.cjs",
    "script:proxies": "tsx scripts/refresh-proxies.ts",
    "script:device": "tsx scripts/generate-device.ts",
    "script:health": "tsx scripts/health-check.ts",
    "script:xbogus": "tsx scripts/generate-xbogus.ts",
    "script:bump": "tsx scripts/bump-version.ts"
  },
  "dependencies": {
    "ofetch": "^1.5.1"
  },
  "optionalDependencies": {
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tsc-esm-fix": "^3.1.2",
    "tsx": "^4.22.4",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
